{% macro gmp_block(ipo) %}
  {% set g = ipo.gmp %}
  {% if g and g.gmp is not none %}
    {% set tone = 'pos' if (g.gmp_pct or 0) >= 10 else ('neg' if (g.gmp or 0) < 0 else ('flat' if (g.gmp or 0) == 0 else 'mild')) %}
    <div class="gmp {{ tone }}">
      <span class="label">GMP</span>
      <span class="big">₹{{ g.gmp|inr }}</span>
      {% if g.gmp_pct is not none %}<span class="pct">({{ '%+.1f'|format(g.gmp_pct) }}%)</span>{% endif %}
      <div class="sub">
        {% if g.est_listing %}Est. listing ₹{{ g.est_listing|inr }}{% endif %}{% if g.est_listing and g.updated %} · {% endif %}{% if g.updated %}updated {{ g.updated }}{% endif %}
        {% if g.stale %}<span class="stale">last known</span>{% endif %}
      </div>
      {# Profit on the minimum application if the stock lists at today's GMP. #}
      {% set app = ipo.get("min_application") or {} %}
      {% set shares = app.get("shares") or ipo.get("lot_size") %}
      {% if shares %}
      {% set profit = g.gmp * shares %}
      <div class="profit">
        Est. profit <b class="{{ 'up' if profit > 0 else 'down' if profit < 0 }}">{{ '+' if profit > 0 else '-' if profit < 0 }}₹{{ (profit|abs)|inr }}</b>
        <span class="sub">on {{ app.get("lots") or 1 }} lot{{ 's' if (app.get("lots") or 1) != 1 }} · {{ shares|inr }} sh</span>
      </div>
      {% endif %}
    </div>
  {% else %}
    <div class="gmp flat"><span class="label">GMP</span><span class="big">—</span><div class="sub">Not reported yet</div></div>
  {% endif %}
{% endmacro %}

{% macro card(ipo, compact=false) %}
{% set gm = ipo.gmp or {} %}
{# What the "My IPOs" tab stores when this IPO is added. #}
{% set snap = {"key": ipo.get("key"), "name": ipo.name, "type": ipo.get("type"), "price": ipo.get("price_high"),
               "lot_size": ipo.get("lot_size"), "lots": (ipo.get("min_application") or {}).get("lots") or 1,
               "open_date": ipo.get("open_date"), "close_date": ipo.get("close_date"),
               "listing_date": ipo.get("listing_date"), "gmp": gm.get("gmp"),
               "url": ipo.get("chittorgarh_url") or ipo.get("ipowatch_url")} %}
<article class="card {{ 'compact' if compact }}" data-type="{{ ipo.type }}"
         data-gmp="{{ gm.gmp_pct if gm.gmp_pct is not none else -999 }}"
         data-date="{{ (ipo.close_date if ipo.status == 'open' else ipo.open_date) or '9999' }}"
         data-size="{{ ipo.issue_size_cr or 0 }}"
         data-sub="{{ (ipo.subscription or {}).total or 0 }}"
         data-ipo='{{ snap|tojson }}'>
  <header>
    <div class="card-head">
      <h3>
        {% if ipo.chittorgarh_url %}<a href="{{ ipo.chittorgarh_url }}" target="_blank" rel="noopener">{{ ipo.name }}</a>{% else %}{{ ipo.name }}{% endif %}
      </h3>
      <button type="button" class="add-btn">+ Add to My IPOs</button>
    </div>
    <div class="badges">
      <span class="badge {{ ipo.type|lower }}">{{ ipo.type }}</span>
      {% if ipo.day_label %}<span class="badge when {{ 'urgent' if ipo.day_label in ('Closes today', 'Closes tomorrow') }}">{{ ipo.day_label }}</span>{% endif %}
      {% if ipo.stale %}<span class="badge stale">stale data</span>{% endif %}
    </div>
    {% if ipo.ipo_date_text or ipo.listing_at %}
    <div class="dates">{{ ipo.ipo_date_text or '' }}{% if ipo.listing_at %} · {{ ipo.listing_at }}{% endif %}{% if ipo.listing_date %} · lists {{ ipo.listing_date }}{% endif %}</div>
    {% endif %}
  </header>

  <div class="stats">
    <div><span class="k">Price band</span><span class="v">{{ ipo.price_band or '—' }}</span></div>
    <div><span class="k">Lot size</span><span class="v">{% if ipo.lot_size %}{{ ipo.lot_size|inr }} shares{% else %}—{% endif %}</span></div>
    <div><span class="k">Min. investment</span><span class="v">
      {% if ipo.min_application %}₹{{ ipo.min_application.amount|inr }}
        <small>{{ ipo.min_application.lots }} lot{{ 's' if ipo.min_application.lots != 1 }} · {{ ipo.min_application.shares|inr }} sh</small>
      {% elif ipo.lot_size and ipo.price_high %}₹{{ (ipo.lot_size * ipo.price_high)|inr }}{% else %}—{% endif %}
    </span></div>
    <div><span class="k">Issue size</span><span class="v">{% if ipo.issue_size_cr %}₹{{ ipo.issue_size_cr|inr }} Cr{% else %}—{% endif %}</span></div>
  </div>

  <div class="live">
    {{ gmp_block(ipo) }}
    {% if ipo.status == 'open' %}
    <div class="subs">
      <span class="label">Subscription</span>
      {% set s = ipo.subscription %}
      {% if s and s.total %}
        <span class="big">{{ '%.2f'|format(s.total) }}x</span>
        <table>
          {% for r in s.rows %}
          <tr><td>{{ r.category }}</td><td>{{ '%.2f'|format(r.times) if r.times is not none else '—' }}x</td></tr>
          {% endfor %}
        </table>
        <div class="sub">as of {{ s.as_of or '—' }}{% if s.stale %} <span class="stale">last known</span>{% endif %}</div>
      {% else %}
        <span class="big muted">—</span><div class="sub">Bidding not started yet</div>
      {% endif %}
    </div>
    {% endif %}
  </div>

  {% if ipo.about %}
  <section class="about">
    <h4>What they do</h4>
    <p>{{ ipo.about[0]|sentences(3) }}</p>
    {% set lists = ipo.about_lists or {} %}
    {% if ipo.about|length > 1 or lists %}
    <details>
      <summary>More about the company</summary>
      {% for p in ipo.about[1:] %}<p>{{ p }}</p>{% endfor %}
      {% for title, items in lists.items() %}
        <h5>{{ title }}</h5>
        <ul>{% for li in items %}<li>{{ li }}</li>{% endfor %}</ul>
      {% endfor %}
    </details>
    {% endif %}
  </section>
  {% elif ipo.partial_source %}
  <section class="about"><p class="muted">Company details not yet available on Chittorgarh.</p></section>
  {% endif %}

  {% set ins = ipo.insights or {} %}
  {% set strengths = ipo.strengths or [] %}
  {% set objects = (ipo.objects or [])|rejectattr('object', 'search', '(?i)general corporate') |list %}
  {% if ins.flags or ins.metrics or objects or strengths or ipo.reviews or ipo.business_news %}
  <section class="signals">
    <h4>Financial signals</h4>
    {% if ins.flags %}
    <div class="flags">{% for f in ins.flags %}<span class="flag {{ f.tone }}">{{ f.text }}</span>{% endfor %}</div>
    {% endif %}
    {% if ins.metrics %}<p class="metrics">{{ ins.metrics|join(' · ') }}</p>{% endif %}
    {% if ins.partial %}<p class="metrics muted">{{ ins.partial }}</p>{% endif %}
    {% if objects %}
      <p class="objects"><b>Money raised will go to:</b>
      {% for o in objects[:2] %}{{ o.object }}{% if o.amount_cr %} (₹{{ o.amount_cr|inr(1) }} Cr){% endif %}{{ '; ' if not loop.last }}{% endfor %}</p>
    {% endif %}
    {% if strengths %}
      <p class="objects"><b>Key strengths:</b> {{ strengths[:3]|join(' ') }}</p>
    {% endif %}
    {% if ipo.reviews %}
      {% set rv = ipo.reviews %}
      <p class="objects muted"><b>Broker reviews:</b>
        {% for k, v in rv.items() if v %}{{ v }} {{ k|lower }}{{ ' · ' if not loop.last }}{% else %}none yet{% endfor %}</p>
    {% endif %}
    {% if ipo.business_news %}
      <h5>Recent developments</h5>
      <ul class="devs">
        {% for n in ipo.business_news %}
        <li class="{{ n.tone }}"><a href="{{ n.link }}" target="_blank" rel="noopener">{{ n.title }}</a>
          <span class="muted">— {{ n.source }}{% if n.date %}, {{ n.date }}{% endif %}</span></li>
        {% endfor %}
      </ul>
    {% endif %}
  </section>
  {% endif %}

  {% if ipo.news %}
  <details class="news">
    <summary>IPO news ({{ ipo.news|length }})</summary>
    <ul>
      {% for n in ipo.news %}
      <li><a href="{{ n.link }}" target="_blank" rel="noopener">{{ n.title }}</a> <span class="muted">— {{ n.source }}{% if n.date %}, {{ n.date }}{% endif %}</span></li>
      {% endfor %}
    </ul>
  </details>
  {% endif %}

  <footer>
    {% if ipo.chittorgarh_url %}<a href="{{ ipo.chittorgarh_url }}" target="_blank" rel="noopener">Chittorgarh</a>{% endif %}
    {% if ipo.ipowatch_url %}<a href="{{ ipo.ipowatch_url }}" target="_blank" rel="noopener">IPOWatch</a>{% endif %}
  </footer>
</article>
{% endmacro %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>IPO Watchlist — {{ generated_display }}</title>
<style>
  :root {
    --bg: #f5f6f8; --card: #fff; --text: #1d2330; --muted: #6b7280; --line: #e5e7eb;
    --green: #0f7b45; --green-bg: #e6f5ec; --red: #b42318; --red-bg: #fdecea;
    --amber: #9a6700; --amber-bg: #fff4d6; --blue: #1d4ed8; --blue-bg: #e8efff; --violet: #6d28d9; --violet-bg: #f1eaff;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1216; --card: #181c22; --text: #e6e8eb; --muted: #9aa3ae; --line: #2a3039;
      --green: #4ade80; --green-bg: #12301f; --red: #f87171; --red-bg: #3a1515;
      --amber: #fbbf24; --amber-bg: #33280d; --blue: #93b4ff; --blue-bg: #1a2545; --violet: #c4a8ff; --violet-bg: #2a1d45;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; font: 15px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background: var(--bg); color: var(--text); }
  a { color: var(--blue); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .wrap { max-width: 1280px; margin: 0 auto; padding: 16px; }
  .top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; margin-bottom: 12px; }
  .top h1 { font-size: 22px; margin: 0; }
  .top .updated { color: var(--muted); font-size: 13px; }
  .controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 8px 0 16px; }
  .seg { display: inline-flex; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: var(--card); }
  .seg button { border: 0; background: none; color: var(--text); padding: 6px 12px; font: inherit; cursor: pointer; }
  .seg button + button { border-left: 1px solid var(--line); }
  .seg button.on { background: var(--blue-bg); color: var(--blue); font-weight: 600; }
  select { font: inherit; padding: 6px 8px; border-radius: 8px; border: 1px solid var(--line); background: var(--card); color: var(--text); }
  .warn { background: var(--amber-bg); color: var(--amber); border-radius: 8px; padding: 8px 12px; margin-bottom: 12px; font-size: 13px; }
  .warn ul { margin: 4px 0 0; padding-left: 18px; }
  h2 { font-size: 17px; margin: 20px 0 10px; }
  h2 .count { color: var(--muted); font-weight: 400; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); gap: 14px; }
  .card { min-width: 0; overflow-wrap: anywhere; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 12px; }
  .card[hidden] { display: none; }
  .card h3 { margin: 0 0 6px; font-size: 17px; }
  .card h3 a { color: var(--text); }
  .badges { display: flex; flex-wrap: wrap; gap: 6px; }
  .badge { font-size: 12px; padding: 2px 8px; border-radius: 999px; background: var(--line); }
  .badge.mainboard { background: var(--blue-bg); color: var(--blue); }
  .badge.sme { background: var(--violet-bg); color: var(--violet); }
  .badge.urgent { background: var(--red-bg); color: var(--red); font-weight: 600; }
  .badge.stale, .stale { background: var(--amber-bg); color: var(--amber); font-size: 11px; padding: 1px 6px; border-radius: 999px; }
  .dates { color: var(--muted); font-size: 13px; margin-top: 6px; }
  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 12px; }
  .stats .k { display: block; color: var(--muted); font-size: 12px; }
  .stats .v { font-weight: 600; }
  .stats small { display: block; font-weight: 400; color: var(--muted); font-size: 12px; }
  .live { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .gmp, .subs { min-width: 0; border-radius: 10px; padding: 10px; background: var(--bg); }
  .label { display: block; font-size: 12px; color: var(--muted); }
  .big { font-size: 22px; font-weight: 700; }
  .pct { font-weight: 600; margin-left: 4px; }
  .gmp.pos .big, .gmp.pos .pct { color: var(--green); }
  .gmp.mild .big, .gmp.mild .pct { color: var(--amber); }
  .gmp.neg .big, .gmp.neg .pct { color: var(--red); }
  .gmp.flat .big { color: var(--muted); }
  .sub { font-size: 12px; color: var(--muted); margin-top: 4px; }
  .gmp .profit { margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--line); font-size: 13px; }
  .gmp .profit b { font-size: 15px; }
  .gmp .profit .sub { display: block; margin-top: 0; }
  .subs table { width: 100%; font-size: 13px; border-collapse: collapse; margin-top: 4px; }
  .subs td:last-child { text-align: right; font-weight: 600; white-space: nowrap; padding-left: 6px; }
  .muted { color: var(--muted); }
  h4 { margin: 0 0 4px; font-size: 13px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  h5 { margin: 8px 0 2px; font-size: 13px; }
  .about p, .signals p { margin: 4px 0; }
  details summary { cursor: pointer; color: var(--blue); font-size: 13px; margin-top: 4px; }
  details ul { margin: 6px 0; padding-left: 18px; }
  details li { margin-bottom: 4px; font-size: 14px; }
  .flags { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0; }
  .flag { font-size: 12px; padding: 3px 8px; border-radius: 6px; font-weight: 600; }
  .flag.good { background: var(--green-bg); color: var(--green); }
  .flag.bad { background: var(--red-bg); color: var(--red); }
  .flag.warn { background: var(--amber-bg); color: var(--amber); }
  .devs { list-style: none; padding: 0; margin: 4px 0; }
  .devs li { font-size: 14px; margin-bottom: 6px; padding-left: 18px; position: relative; }
  .devs li::before { content: "•"; position: absolute; left: 4px; color: var(--muted); }
  .devs li.good::before { content: "▲"; color: var(--green); font-size: 11px; top: 2px; }
  .devs li.bad::before { content: "▼"; color: var(--red); font-size: 11px; top: 2px; }
  .metrics { font-size: 14px; }
  .objects { font-size: 14px; }
  .card > footer { margin-top: auto; display: flex; gap: 14px; font-size: 13px; border-top: 1px solid var(--line); padding-top: 8px; }
  .empty { color: var(--muted); padding: 20px; background: var(--card); border-radius: 12px; border: 1px dashed var(--line); }
  .upcoming-wrap > summary { font-size: 17px; font-weight: 700; color: var(--text); margin: 20px 0 10px; }
  .disclaimer { color: var(--muted); font-size: 12px; margin: 28px 0 8px; }

  /* Tabs */
  .tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--line); margin-bottom: 14px; }
  .tabs button { border: 0; background: none; color: var(--muted); font: inherit; font-weight: 600; padding: 8px 14px;
                 cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .tabs button.on { color: var(--blue); border-bottom-color: var(--blue); }
  .tabs .n { display: inline-block; min-width: 20px; padding: 0 6px; margin-left: 4px; border-radius: 999px;
             background: var(--blue-bg); color: var(--blue); font-size: 12px; }

  /* Add button on cards */
  .card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
  .add-btn { flex: none; font: inherit; font-size: 12px; font-weight: 600; padding: 5px 10px; border-radius: 8px; cursor: pointer;
             border: 1px solid var(--blue); background: none; color: var(--blue); white-space: nowrap; }
  .add-btn:hover { background: var(--blue-bg); }
  .add-btn.added { border-color: var(--green); color: var(--green); background: var(--green-bg); }

  /* My IPOs */
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(160px, 100%), 1fr)); gap: 10px; margin-bottom: 18px; }
  .tile { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px; }
  .tile .k { display: block; color: var(--muted); font-size: 12px; }
  .tile .v { font-size: 20px; font-weight: 700; }
  .tile small { display: block; color: var(--muted); font-size: 12px; }
  .up { color: var(--green); } .down { color: var(--red); }
  .my-list { display: flex; flex-direction: column; gap: 10px; }
  .my-row { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px;
            display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1.1fr) auto; gap: 8px 16px; align-items: center; }
  .my-row .name { font-weight: 700; }
  .my-row .name a { color: var(--text); }
  .my-row .meta { color: var(--muted); font-size: 12px; margin-top: 2px; }
  .my-row .gain { font-size: 18px; font-weight: 700; }
  .my-row .lots { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; }
  .my-row .lots input { width: 56px; font: inherit; padding: 3px 6px; border-radius: 6px; border: 1px solid var(--line);
                        background: var(--bg); color: var(--text); }
  .actions { display: flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end; }
  .btn { font: inherit; font-size: 13px; font-weight: 600; padding: 6px 12px; border-radius: 8px; cursor: pointer;
         border: 1px solid var(--line); background: var(--bg); color: var(--text); }
  .btn.good { border-color: var(--green); color: var(--green); background: var(--green-bg); }
  .btn.bad { border-color: var(--red); color: var(--red); background: var(--red-bg); }
  .note { color: var(--muted); font-size: 13px; margin: 10px 0 0; }
  .toast { position: fixed; left: 50%; transform: translateX(-50%); bottom: calc(16px + env(safe-area-inset-bottom, 0px));
           background: var(--text); color: var(--bg); padding: 10px 14px; border-radius: 10px; font-size: 14px;
           display: flex; gap: 12px; align-items: center; box-shadow: 0 4px 16px rgba(0,0,0,.25); z-index: 10; }
  .toast[hidden] { display: none; }
  .sync { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 10px 14px; margin-bottom: 14px; font-size: 14px; }
  .sync summary { color: var(--blue); font-weight: 600; font-size: 14px; margin: 0; }
  .sync ol { padding-left: 20px; margin: 10px 0; }
  .sync li { margin-bottom: 6px; }
  .sync.on { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; justify-content: space-between; }
  .sync-form { display: flex; gap: 8px; flex-wrap: wrap; }
  .sync-form input { flex: 1 1 220px; min-width: 0; font: inherit; padding: 6px 10px; border-radius: 8px;
                     border: 1px solid var(--line); background: var(--bg); color: var(--text); }
  .toast button { border: 0; background: none; color: inherit; font: inherit; font-weight: 700; text-decoration: underline; cursor: pointer; }
  @media (max-width: 700px) {
    .my-row { grid-template-columns: minmax(0, 1fr); gap: 6px; }
    .my-row .actions { justify-content: flex-start; }
  }
  @media (max-width: 420px) { .grid { grid-template-columns: 1fr; } .live { grid-template-columns: 1fr; } }
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <h1>IPO Watchlist</h1>
    <span class="updated">Last updated: {{ generated_display }}</span>
  </div>

  {% if warnings %}
  <div class="warn">
    <b>Some data could not be refreshed:</b>
    <ul>{% for w in warnings[:8] %}<li>{{ w }}</li>{% endfor %}</ul>
  </div>
  {% endif %}

  <nav class="tabs" role="tablist">
    <button type="button" role="tab" data-tab="ipos" class="on">IPOs</button>
    <button type="button" role="tab" data-tab="my">My IPOs <span class="n" id="myCount">0</span></button>
  </nav>

  <section id="tab-ipos">
  <div class="controls">
    <div class="seg" id="typeFilter">
      <button class="on" data-v="all">All</button>
      <button data-v="Mainboard">Mainboard</button>
      <button data-v="SME">SME</button>
    </div>
    <label>Sort
      <select id="sortBy">
        <option value="date">Closing soonest</option>
        <option value="gmp">GMP % (high → low)</option>
        <option value="sub">Subscription (high → low)</option>
        <option value="size">Issue size (large → small)</option>
      </select>
    </label>
  </div>

  <h2>Open for application <span class="count" data-count-for="openGrid">({{ open|length }})</span></h2>
  {% if open %}
  <div class="grid" id="openGrid">
    {% for ipo in open %}{{ card(ipo) }}{% endfor %}
  </div>
  {% else %}
  <div class="empty">No IPOs are open for application today.</div>
  {% endif %}

  {% if upcoming %}
  <details class="upcoming-wrap">
    <summary>Opening soon <span class="count muted" data-count-for="upGrid">({{ upcoming|length }})</span></summary>
    <div class="grid" id="upGrid">
      {% for ipo in upcoming %}{{ card(ipo, compact=true) }}{% endfor %}
    </div>
  </details>
  {% endif %}
  </section>

  <section id="tab-my" hidden>
    <div id="syncBox"></div>
    <div id="myTiles" class="tiles"></div>
    <div id="myApplied"></div>
    <div id="myAllotted"></div>
    <p class="note">
      Without sync, your list is saved in this browser only. Gains for listed IPOs use the current price from
      chittorgarh.com as of the last update. Before listing, the expected gain uses the latest GMP, which is unofficial.
    </p>
  </section>

  <p class="disclaimer">
    Data from <a href="https://www.chittorgarh.com/">chittorgarh.com</a>, <a href="https://www.ipowatch.in/">ipowatch.in</a>
    and Google News, refreshed every morning. Grey market premium (GMP) is unofficial and can change quickly.
    Financial signals are computed automatically from the restated financials in the offer documents.
    This page is for information only and is not investment advice.
  </p>
</div>
<div id="toast" class="toast" hidden></div>
<script id="marketData" type="application/json">{{ market|default({})|tojson }}</script>
<script>
(function () {
  // ------------------------------------------------------------ IPO list: filter + sort
  var grids = ['openGrid', 'upGrid'].map(function (id) { return document.getElementById(id); }).filter(Boolean);
  var type = 'all';

  function apply() {
    var sort = document.getElementById('sortBy').value;
    grids.forEach(function (grid) {
      var cards = Array.prototype.slice.call(grid.children);
      cards.sort(function (a, b) {
        if (sort === 'date') return a.dataset.date.localeCompare(b.dataset.date) || (b.dataset.gmp - a.dataset.gmp);
        return parseFloat(b.dataset[sort]) - parseFloat(a.dataset[sort]);
      });
      var shown = 0;
      cards.forEach(function (c) {
        c.hidden = type !== 'all' && c.dataset.type !== type;
        if (!c.hidden) shown++;
        grid.appendChild(c);
      });
      var counter = document.querySelector('[data-count-for="' + grid.id + '"]');
      if (counter) counter.textContent = '(' + shown + ')';
    });
  }

  document.querySelectorAll('#typeFilter button').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('#typeFilter button').forEach(function (b) { b.classList.remove('on'); });
      btn.classList.add('on');
      type = btn.dataset.v;
      apply();
    });
  });
  document.getElementById('sortBy').addEventListener('change', apply);

  // ------------------------------------------------------------ My IPOs: local copy + optional Gist sync
  var STORE_KEY = 'ipoWatchlist.myIpos.v1';
  var STAMP_KEY = 'ipoWatchlist.myIpos.updatedAt';   // ms timestamp of the last change to the list
  var SYNC_KEY = 'ipoWatchlist.sync.v1';             // {token, gistId, login, base}
  var GIST_FILE = 'ipo-watchlist-my-ipos.json';
  var market = {};
  try { market = JSON.parse(document.getElementById('marketData').textContent) || {}; } catch (e) {}
  var storageOk = true;

  function getItem(k) { try { return localStorage.getItem(k); } catch (e) { storageOk = false; return null; } }
  function setItem(k, v) { try { localStorage.setItem(k, v); } catch (e) { storageOk = false; } }
  function removeItem(k) { try { localStorage.removeItem(k); } catch (e) {} }
  function load() { try { return JSON.parse(getItem(STORE_KEY)) || []; } catch (e) { return []; } }
  function localStamp() { return +getItem(STAMP_KEY) || 0; }
  function store(list, stamp) { setItem(STORE_KEY, JSON.stringify(list)); setItem(STAMP_KEY, String(stamp)); }
  /** Every edit goes through here: saves locally, then uploads if sync is on. */
  function save(list) { store(list, Date.now()); schedulePush(); }
  var mine = load();

  // ---- GitHub Gist sync. The token only needs the "gist" scope and stays in this browser.
  var sync = { cfg: null, status: '', error: '', timer: null };
  try { sync.cfg = JSON.parse(getItem(SYNC_KEY)); } catch (e) {}

  function gh(path, opts) {
    opts = opts || {};
    return fetch('https://api.github.com' + path, {
      method: opts.method || 'GET',
      cache: 'no-store',
      headers: { 'Authorization': 'Bearer ' + (opts.token || sync.cfg.token),
                 'Accept': 'application/vnd.github+json', 'Content-Type': 'application/json' },
      body: opts.body ? JSON.stringify(opts.body) : undefined
    }).then(function (r) {
      if (r.ok) return r.json();
      throw new Error(r.status === 401 ? 'GitHub rejected the token (wrong or expired)'
        : r.status === 403 || r.status === 404 ? 'the token is missing the "gist" permission'
        : 'GitHub error ' + r.status);
    }, function () { throw new Error('no internet connection'); });
  }
  function readGist(gist) {
    var f = gist && gist.files && gist.files[GIST_FILE];
    try { return f ? JSON.parse(f.content) : null; } catch (e) { return null; }
  }
  function gistBody() {
    var files = {};
    files[GIST_FILE] = { content: JSON.stringify({ app: 'ipo-watchlist', updated_at: localStamp(), items: mine }, null, 1) };
    return files;
  }
  /** Entries of `extra` whose IPO isn't already in `base` are appended to it. */
  function merge(base, extra) {
    var out = base.slice();
    (extra || []).forEach(function (e) { if (!out.some(function (o) { return o.key === e.key; })) out.push(e); });
    return out;
  }
  function saveCfg() { setItem(SYNC_KEY, JSON.stringify(sync.cfg)); }
  function setSync(status, error) { sync.status = status; sync.error = error || ''; renderSync(); }
  function fail(err) { setSync('error', err.message); }

  /** Download the Gist; take it if it's newer than this device's copy, upload ours if ours is newer. */
  function pull() {
    if (!sync.cfg) return;
    setSync('syncing');
    gh('/gists/' + sync.cfg.gistId).then(function (gist) {
      var remote = readGist(gist) || { updated_at: 0, items: [] };
      sync.cfg.base = remote.updated_at; saveCfg();
      if (remote.updated_at > localStamp()) {
        mine = remote.items || [];
        store(mine, remote.updated_at);
        renderMine();
        setSync('ok');
      } else if (remote.updated_at < localStamp()) {
        push();
      } else {
        setSync('ok');
      }
    }).catch(fail);
  }

  /** Upload this device's list. If another device changed the Gist since we last saw it, merge first. */
  function push() {
    if (!sync.cfg) return;
    setSync('syncing');
    gh('/gists/' + sync.cfg.gistId).then(function (gist) {
      var remote = readGist(gist);
      if (remote && remote.updated_at > (sync.cfg.base || 0)) {
        mine = merge(mine, remote.items);
        store(mine, Date.now());
        renderMine();
      }
      return gh('/gists/' + sync.cfg.gistId, { method: 'PATCH', body: { files: gistBody() } });
    }).then(function () {
      sync.cfg.base = localStamp(); saveCfg();
      setSync('ok');
    }).catch(fail);
  }
  function schedulePush() {
    if (!sync.cfg) return;
    clearTimeout(sync.timer);
    sync.timer = setTimeout(push, 500);
  }

  /** First-time setup on a device: find (or create) the Gist and merge both lists so nothing is lost. */
  function connect(token) {
    setSync('connecting');
    var login;
    gh('/user', { token: token }).then(function (user) {
      login = user.login;
      return gh('/gists?per_page=100', { token: token });
    }).then(function (gists) {
      var found = (gists || []).filter(function (g) { return g.files && g.files[GIST_FILE]; })[0];
      if (found) {
        return gh('/gists/' + found.id, { token: token }).then(function (gist) {
          var remote = readGist(gist) || { items: [] };
          mine = merge(remote.items || [], mine);
          store(mine, Date.now());
          sync.cfg = { token: token, gistId: found.id, login: login, base: 0 };
          saveCfg();
          renderMine();
          push();
        });
      }
      store(mine, Date.now());
      return gh('/gists', { method: 'POST', token: token,
                            body: { description: 'IPO Watchlist - My IPOs (synced by the page)', public: false,
                                    files: gistBody() } })
        .then(function (gist) {
          sync.cfg = { token: token, gistId: gist.id, login: login, base: localStamp() };
          saveCfg();
          setSync('ok');
        });
    }).catch(function (err) { sync.cfg = null; fail(err); });
  }
  function disconnect() {
    clearTimeout(sync.timer);
    sync.cfg = null;
    removeItem(SYNC_KEY);
    setSync('');
  }

  function ago(ms) {
    var s = Math.round((Date.now() - ms) / 1000);
    return s < 60 ? 'just now' : s < 3600 ? Math.round(s / 60) + ' min ago' : new Date(ms).toLocaleString('en-IN');
  }
  function renderSync() {
    var box = document.getElementById('syncBox');
    if (!box) return;
    if (sync.cfg) {
      var state = sync.status === 'syncing' ? 'Syncing…'
        : sync.status === 'error' ? '<span class="down">Sync failed: ' + esc(sync.error) + '</span>'
        : 'Up to date · last change ' + (localStamp() ? ago(localStamp()) : 'none yet');
      box.innerHTML = '<div class="sync on"><span>☁ Synced with GitHub as <b>' + esc(sync.cfg.login) + '</b> · ' + state +
        '</span><span class="actions"><button type="button" class="btn" data-sync="now">Sync now</button>' +
        '<button type="button" class="btn" data-sync="off">Disconnect</button></span></div>';
      return;
    }
    var open = box.querySelector('details') && box.querySelector('details').open;
    // GitHub requires each token's note to be unique, so name it after this device and time.
    var device = /Mobi|Android|iPhone|iPad/i.test(navigator.userAgent) ? 'phone' : 'computer';
    var note = 'IPO Watchlist sync (' + device + ', ' + new Date().toLocaleString('en-IN', {
      day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) + ')';
    var tokenUrl = 'https://github.com/settings/tokens/new?scopes=gist&description=' + encodeURIComponent(note);
    box.innerHTML =
      '<details class="sync"' + (open || sync.status ? ' open' : '') + '><summary>☁ Sync My IPOs across your phone and laptop</summary>' +
      '<ol>' +
        '<li>Open <a href="' + esc(tokenUrl) + '" ' +
        'target="_blank" rel="noopener">this GitHub page</a> while signed in. The <b>gist</b> box is already ticked. ' +
        'Set <b>Expiration</b> to <b>No expiration</b>, click <b>Generate token</b> at the bottom, and copy the token.</li>' +
        '<li>Paste it below and tap <b>Connect</b>. Do the same on your other devices (make a new token there, or reuse this one).</li>' +
      '</ol>' +
      '<form id="syncForm" class="sync-form"><input id="syncToken" type="password" placeholder="ghp_…" autocomplete="off" ' +
        'spellcheck="false" required><button type="submit" class="btn good">' +
        (sync.status === 'connecting' ? 'Connecting…' : 'Connect') + '</button></form>' +
      (sync.status === 'error' ? '<p class="down">Couldn\'t connect: ' + esc(sync.error) + '</p>' : '') +
      '<p class="note">The token can only read and write your Gists, not your code or account settings. ' +
        'It is kept in this browser only. Your list is saved in a secret Gist named ' + GIST_FILE + '.</p>' +
      '</details>';
  }

  // Names differ between sources ("German Green Steel" vs "German Green Steel & Power"): match on
  // identical normalised keys, or when the shorter key (2+ words) is the start of the longer one.
  function sameIpo(a, b) {
    if (!a || !b) return false;
    if (a === b) return true;
    var x = a.split(' '), y = b.split(' ');
    var s = x.length <= y.length ? x : y, l = x.length <= y.length ? y : x;
    return s.length >= 2 && l.slice(0, s.length).join(' ') === s.join(' ');
  }
  function find(list, key) {
    for (var i = 0; i < (list || []).length; i++) if (sameIpo(list[i].key, key)) return list[i];
    return null;
  }

  // Latest data for an IPO that is still on today's page (newest GMP etc.).
  var liveByKey = {};
  document.querySelectorAll('.card[data-ipo]').forEach(function (card) {
    try { var d = JSON.parse(card.dataset.ipo); liveByKey[d.key] = d; } catch (e) {}
  });

  function inr(n) {
    if (n === null || n === undefined || isNaN(n)) return '—';
    var sign = n < 0 ? '-' : '';
    return sign + '₹' + Math.round(Math.abs(n)).toLocaleString('en-IN');
  }
  function signedInr(n) { return (n > 0 ? '+' : '') + inr(n); }
  function pct(n) { return (n > 0 ? '+' : '') + n.toFixed(2) + '%'; }
  function tone(n) { return n > 0 ? 'up' : n < 0 ? 'down' : ''; }
  function fmtDate(iso) {
    if (!iso) return '';
    var d = new Date(iso + 'T00:00:00');
    return isNaN(d) ? iso : d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
  }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  /** Invested amount and gain for one entry. */
  function valuation(e) {
    var shares = (e.lots || 1) * (e.lot_size || 0);
    var invested = e.price && shares ? e.price * shares : null;
    var perf = find(market.performance, e.key);
    if (perf && invested && perf.current_gain_pct !== null) {
      return { shares: shares, invested: invested, gain: invested * perf.current_gain_pct / 100,
               pctNow: perf.current_gain_pct, pctListing: perf.listing_gain_pct, listed: true };
    }
    var live = liveByKey[e.key] || null;
    var g = find(market.gmp, e.key);
    var gmp = live && live.gmp !== null && live.gmp !== undefined ? live.gmp
            : g && g.gmp !== null ? g.gmp : e.gmp;
    if (invested && gmp !== null && gmp !== undefined) {
      return { shares: shares, invested: invested, gain: gmp * shares, gmp: gmp,
               pctNow: e.price ? gmp / e.price * 100 : null, listed: false };
    }
    return { shares: shares, invested: invested, gain: null, listed: false };
  }

  function rowHtml(e, i) {
    var v = valuation(e);
    var link = e.url ? '<a href="' + esc(e.url) + '" target="_blank" rel="noopener">' + esc(e.name) + '</a>' : esc(e.name);
    var head = '<div><div class="name">' + link + ' <span class="badge ' + esc((e.type || '').toLowerCase()) + '">' +
               esc(e.type) + '</span></div>';
    if (e.status !== 'allotted') {
      var when = e.close_date ? 'Bidding closes ' + fmtDate(e.close_date) : '';
      return '<div class="my-row">' + head +
        '<div class="meta">Applied ' + (e.lots || 1) + ' lot' + ((e.lots || 1) > 1 ? 's' : '') +
        (v.invested ? ' · ' + inr(v.invested) + ' blocked' : '') + (when ? ' · ' + when : '') + '</div></div>' +
        '<div class="meta">Awaiting allotment</div><div></div>' +
        '<div class="actions">' +
          '<button type="button" class="btn good" data-act="allotted" data-i="' + i + '">Allotted</button>' +
          '<button type="button" class="btn bad" data-act="remove" data-i="' + i + '">Not allotted</button>' +
        '</div></div>';
    }
    var status;
    if (v.listed) {
      status = 'Listed · listing day <b class="' + tone(v.pctListing) + '">' + pct(v.pctListing) + '</b> · now <b class="' +
               tone(v.pctNow) + '">' + pct(v.pctNow) + '</b>';
    } else if (v.gain !== null) {
      status = 'Not listed yet' + (e.listing_date ? ' (lists ' + esc(e.listing_date) + ')' : '') +
               ' · expected from GMP ₹' + v.gmp;
    } else {
      status = 'No price data yet';
    }
    return '<div class="my-row">' + head +
      '<div class="meta"><label class="lots">Lots allotted <input type="number" min="1" step="1" value="' + (e.lots || 1) +
      '" data-act="lots" data-i="' + i + '"></label> · ' + v.shares + ' shares · invested ' + inr(v.invested) + '</div></div>' +
      '<div class="meta">' + status + '</div>' +
      '<div><div class="gain ' + tone(v.gain) + '">' + (v.gain === null ? '—' : signedInr(v.gain)) + '</div>' +
      '<div class="meta">' + (v.listed ? 'current gain' : v.gain !== null ? 'expected gain' : '') +
      (v.pctNow !== null && v.pctNow !== undefined && v.gain !== null ? ' · ' + pct(v.pctNow) : '') + '</div></div>' +
      '<div class="actions"><button type="button" class="btn" data-act="remove" data-i="' + i + '">Remove</button></div>' +
      '</div>';
  }

  function renderMine() {
    document.getElementById('myCount').textContent = mine.length;
    var applied = [], allotted = [];
    mine.forEach(function (e, i) { (e.status === 'allotted' ? allotted : applied).push([e, i]); });

    var tiles = document.getElementById('myTiles');
    if (!storageOk) {
      tiles.innerHTML = '<div class="warn">This browser is blocking saved data (private mode?), so My IPOs cannot be kept.</div>';
    } else if (!mine.length) {
      tiles.innerHTML = '<div class="empty">No IPOs added yet. Tap <b>+ Add to My IPOs</b> on an IPO card when you apply.</div>';
    } else {
      var invested = 0, gain = 0, priced = 0;
      allotted.forEach(function (p) {
        var v = valuation(p[0]);
        if (v.invested) invested += v.invested;
        if (v.gain !== null) { gain += v.gain; priced++; }
      });
      tiles.innerHTML =
        '<div class="tile"><span class="k">Allotted IPOs</span><span class="v">' + allotted.length + '</span>' +
          '<small>' + applied.length + ' awaiting allotment</small></div>' +
        '<div class="tile"><span class="k">Invested</span><span class="v">' + inr(invested) + '</span><small>in allotted IPOs</small></div>' +
        '<div class="tile"><span class="k">Total gain</span><span class="v ' + tone(gain) + '">' +
          (priced ? signedInr(gain) : '—') + '</span><small>' +
          (priced && invested ? pct(gain / invested * 100) + ' · ' : '') + 'listed + expected</small></div>';
    }

    document.getElementById('myApplied').innerHTML = applied.length
      ? '<h2>Awaiting allotment <span class="count">(' + applied.length + ')</span></h2><div class="my-list">' +
        applied.map(function (p) { return rowHtml(p[0], p[1]); }).join('') + '</div>' : '';
    document.getElementById('myAllotted').innerHTML = allotted.length
      ? '<h2>Allotted <span class="count">(' + allotted.length + ')</span></h2><div class="my-list">' +
        allotted.map(function (p) { return rowHtml(p[0], p[1]); }).join('') + '</div>' : '';

    document.querySelectorAll('.card[data-ipo]').forEach(function (card) {
      var btn = card.querySelector('.add-btn');
      var key = JSON.parse(card.dataset.ipo).key;
      var added = mine.some(function (e) { return e.key === key; });
      btn.classList.toggle('added', added);
      btn.textContent = added ? '✓ In My IPOs' : '+ Add to My IPOs';
    });
  }

  var toastTimer;
  function toast(msg, undo) {
    var t = document.getElementById('toast');
    t.innerHTML = '<span>' + esc(msg) + '</span>' + (undo ? '<button type="button">Undo</button>' : '');
    t.hidden = false;
    if (undo) t.querySelector('button').onclick = function () { undo(); t.hidden = true; };
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { t.hidden = true; }, 6000);
  }

  document.addEventListener('click', function (ev) {
    var add = ev.target.closest('.add-btn');
    if (add) {
      var d = JSON.parse(add.closest('.card').dataset.ipo);
      if (mine.some(function (e) { return e.key === d.key; })) { showTab('my'); return; }
      d.status = 'applied';
      d.added_on = new Date().toISOString().slice(0, 10);
      mine.push(d);
      save(mine); renderMine();
      toast('Added ' + d.name + ' to My IPOs');
      return;
    }
    var btn = ev.target.closest('[data-act]');
    if (!btn || btn.tagName === 'INPUT') return;
    var i = +btn.dataset.i, e = mine[i];
    if (!e) return;
    if (btn.dataset.act === 'allotted') {
      e.status = 'allotted';
      save(mine); renderMine();
    } else if (btn.dataset.act === 'remove') {
      mine.splice(i, 1);
      save(mine); renderMine();
      toast('Removed ' + e.name, function () { mine.splice(i, 0, e); save(mine); renderMine(); });
    }
  });
  document.addEventListener('change', function (ev) {
    if (ev.target.dataset.act !== 'lots') return;
    var e = mine[+ev.target.dataset.i], n = parseInt(ev.target.value, 10);
    if (e && n >= 1) { e.lots = n; save(mine); }
    renderMine();
  });

  // ------------------------------------------------------------ Tabs
  function showTab(name) {
    document.querySelectorAll('.tabs button').forEach(function (b) { b.classList.toggle('on', b.dataset.tab === name); });
    document.getElementById('tab-ipos').hidden = name !== 'ipos';
    document.getElementById('tab-my').hidden = name !== 'my';
    try { history.replaceState(null, '', name === 'my' ? '#my' : location.pathname + location.search); } catch (e) {}
  }
  document.querySelectorAll('.tabs button').forEach(function (b) {
    b.addEventListener('click', function () { showTab(b.dataset.tab); });
  });
  window.addEventListener('storage', function (ev) { if (ev.key === STORE_KEY) { mine = load(); renderMine(); } });

  // ------------------------------------------------------------ Sync controls
  document.addEventListener('submit', function (ev) {
    if (ev.target.id !== 'syncForm') return;
    ev.preventDefault();
    var token = document.getElementById('syncToken').value.trim();
    if (token) connect(token);
  });
  document.addEventListener('click', function (ev) {
    var b = ev.target.closest('[data-sync]');
    if (!b) return;
    if (b.dataset.sync === 'now') pull();
    if (b.dataset.sync === 'off') disconnect();
  });
  // Pick up changes made on another device when you come back to this tab (e.g. reopening on the phone).
  document.addEventListener('visibilitychange', function () { if (!document.hidden) pull(); });

  renderMine();
  renderSync();
  showTab(location.hash === '#my' ? 'my' : 'ipos');
  pull();
})();
</script>
</body>
</html>
